+def test_promptlens_gateway_keeps_claude_code_identity_and_native_thinking():
+    """Claude Teams gateways need Claude Code identity and native signed-thinking replay."""
+    from agent.anthropic_endpoints import _is_third_party_anthropic_endpoint
+
+    promptlens = "https://promptlens.trilogy.com/v1"
+    assert anthropic_route_is_oauth(promptlens, "dummykey") is True
+    assert _is_third_party_anthropic_endpoint(promptlens) is False
+    assert _is_third_party_anthropic_endpoint("https://api.minimax.io/anthropic") is True
+
+
+@pytest.mark.parametrize("base_url", [
+    "https://promptlens.trilogy.com.evil.example/v1",
+    "https://evil.example/promptlens.trilogy.com/v1",
+    "https://evil.example/v1?next=https://promptlens.trilogy.com",
+    "https://promptlens.trilogy.com@evil.example/v1",
+])
+def test_promptlens_lookalikes_stay_third_party(base_url):
+    from agent.anthropic_endpoints import _is_third_party_anthropic_endpoint
+
+    assert anthropic_route_is_oauth(base_url, "opaque") is False
+    assert _is_third_party_anthropic_endpoint(base_url) is True
+
+
+@pytest.mark.parametrize("base_url,expected", [
+    ("", False),
+    ("https://api.anthropic.com/v1", False),
+    ("https://api.anthropic.com.evil.example/v1", True),
+    ("https://evil.example/api.anthropic.com/v1", True),
+    ("https://evil.example/v1?next=https://api.anthropic.com", True),
+    ("https://api.anthropic.com@evil.example/v1", True),
+    ("https://notanthropic.com/v1", True),
+])
+def test_native_anthropic_endpoint_requires_exact_hostname(base_url, expected):
+    from agent.anthropic_endpoints import _is_third_party_anthropic_endpoint
+
+    assert _is_third_party_anthropic_endpoint(base_url) is expected
+
+
+@pytest.mark.parametrize("provider", [
+    "not-truefoundry",
+    "truefoundry.evil",
+    "not-claude-teams",
+    "claude-teams.evil",
+    "truefoundry-claude-teams.evil",
+])
+def test_trusted_provider_name_substrings_do_not_grant_oauth_identity(provider):
+    assert anthropic_route_is_oauth(
+        "https://gateway.example.com/anthropic", "opaque", provider=provider
+    ) is False
+
+
+@pytest.mark.parametrize("base_url,provider", [
+    ("https://promptlens.trilogy.com/v1", None),
+    ("https://gateway.example.com/anthropic", "truefoundry"),
+    ("https://gateway.example.com/anthropic", "claude-teams"),
+    ("https://gateway.example.com/anthropic", "truefoundry-claude-teams"),
+])
+def test_trusted_routes_reject_console_api_keys(base_url, provider):
+    assert anthropic_route_is_oauth(base_url, CONSOLE, provider=provider) is False
+    assert anthropic_route_is_oauth(base_url, lambda: CONSOLE, provider=provider) is False
+
+
+@pytest.mark.parametrize("base_url,credential,provider,expected", [
+    ("https://api.anthropic.com", OAUTH, None, True),
+    ("https://api.minimax.io/anthropic", OAUTH, None, False),
+    ("https://gateway.example.com/anthropic", "opaque", "claude-teams", True),
+    ("https://gateway.example.com/anthropic", "opaque", "claude-teams.evil", False),
+])
+def test_auxiliary_anthropic_wrapper_uses_route_identity(base_url, credential, provider, expected):
+    """Side calls follow the same route-identity decision as the main chat client."""
+    pytest.importorskip("anthropic")
+    import agent.auxiliary_client as aux
+
+    route_provider = provider or "custom"
+    request = aux._ResolveRequest(
+        provider=route_provider,
+        original_provider=route_provider,
+        model="claude-opus-5-5",
+        async_mode=False,
+        raw_codex=False,
+        explicit_base_url=base_url,
+        explicit_api_key=credential,
+        api_mode="anthropic_messages",
+        main_runtime=None,
+        is_vision=False,
+        task=None,
+    )
+    wrapped = aux._wrap_transport(request, object(), "claude-opus-5-5", base_url, credential)
+    assert wrapped.chat.completions._is_oauth is expected
