-    """Anthropic requires ids matching [a-zA-Z0-9_-]; replace the rest, never empty."""
-    return (re.sub(r"[^a-zA-Z0-9_-]", "_", tool_id) if tool_id else "") or "tool_0"
+    """Anthropic/Bedrock require ids matching [a-zA-Z0-9_-] and <=64 chars; strip TrueFoundry __thought__ suffix or hash-truncate >64 chars."""
+    if not tool_id:
+        return "tool_0"
+    if "__thought__" in tool_id:
+        tool_id = tool_id.split("__thought__", 1)[0]
+    cleaned = re.sub(r"[^a-zA-Z0-9_-]", "_", tool_id) or "tool_0"
+    if len(cleaned) > 64:
+        cleaned = f"{cleaned[:47]}_{hashlib.sha256(cleaned.encode()).hexdigest()[:16]}"
+    return cleaned
 
 
