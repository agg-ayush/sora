+def test_trilogy_seatbelt_gateway_keeps_claude_code_identity_and_native_thinking():
+    """The Seatbelt gateway proxies a Claude Teams seat: without the Claude Code identity Anthropic
+    429s/400s Opus and Sonnet, and treating it as third-party would strip prior signed thinking."""
+    from agent.anthropic_endpoints import _is_third_party_anthropic_endpoint
+
+    seatbelt = "https://<model-gateway>"
+    assert anthropic_route_is_oauth(seatbelt, "dummykey") is True
+    assert _is_third_party_anthropic_endpoint(seatbelt) is False
+    assert _is_third_party_anthropic_endpoint("https://api.minimax.io/anthropic") is True
+
+
+@pytest.mark.parametrize("base_url,expected", [
+    ("https://<model-gateway>", True),  # Trilogy gateway: Claude Code identity
+    ("https://api.minimax.io/anthropic", False),  # third-party Anthropic-protocol endpoint: never
+])
