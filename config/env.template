# .env template — copy to ~/.hermes/.env and fill in real values.
# NEVER commit the real .env — it contains secrets.

# TrueFoundry — two distinct keys:
# TFY_API_KEY: used by the claude/codex CLIs themselves (exported into tmux by the plugin)
# TRUEFOUNDRY_API_KEY: used by hermes's own provider config (providers.truefoundry.api_key)
TFY_API_KEY=
TRUEFOUNDRY_API_KEY=

# WhatsApp bridge (disabled — bridge drops from-me group messages on personal number)
WHATSAPP_ENABLED=false
WHATSAPP_MODE=bot
WHATSAPP_ALLOWED_USERS=

# Telegram bot token (configured via `hermes gateway setup`)
TELEGRAM_BOT_TOKEN=
