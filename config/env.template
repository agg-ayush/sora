# .env template — copy to ~/.hermes/.env and fill in real values.
# NEVER commit the real .env — it contains secrets.

# TrueFoundry — two distinct keys:
# TFY_API_KEY: used by the claude/codex CLIs themselves (exported into tmux by the plugin)
# TRUEFOUNDRY_API_KEY: used by hermes's own provider config (providers.truefoundry.api_key)
TFY_API_KEY=
TRUEFOUNDRY_API_KEY=
# TRUEFOUNDRY_PERSONAL_TOKEN: providers.truefoundry-gpt6 / seatbelt-codex api_key and the seatbelt x-tfy-api-key header
TRUEFOUNDRY_PERSONAL_TOKEN=
# MAAT_API_TOKEN: x-maat-token header for the Seatbelt gateway
MAAT_API_TOKEN=

# Fireworks (fallback + auxiliary routes: kimi-k3p1-pro, glm-5p3-flash)
FIREWORKS_API_KEY=

# MCP server Authorization headers (full header value, e.g. "Bearer ...")
SUPABASE_MCP_AUTHORIZATION=
TICOONS_MCP_AUTHORIZATION=
RECALL_MCP_AUTHORIZATION=

# WhatsApp bridge (disabled — bridge drops from-me group messages on personal number)
WHATSAPP_ENABLED=false
WHATSAPP_MODE=bot
WHATSAPP_ALLOWED_USERS=

# Telegram bot token (configured via `hermes gateway setup`)
TELEGRAM_BOT_TOKEN=

# Telegram gateway access + home channel (sora only; the Mac must NOT set TELEGRAM_BOT_TOKEN).
# TELEGRAM_HOME_CHANNEL is the chat id behind delivery target "telegram" and platforms.telegram.home_channel.
TELEGRAM_ALLOWED_USERS=
GATEWAY_ALLOWED_USERS=
TELEGRAM_HOME_CHANNEL=
TELEGRAM_HOME_CHANNEL_THREAD_ID=
# Group chat id for the TI concern watcher (sora); unset -> alerts go to the Telegram home channel
TI_CONCERN_TELEGRAM_CHAT=

# Third-party API keys used by tools, skills and MCP servers
GITHUB_TOKEN=
NOTION_API_KEY=
PARALLEL_API_KEY=
RECALL_API_KEY=
MCP_SUPABASE_API_KEY=

# ti-hiring / SDE screening automation (sora)
GOG_KEYRING_PASSWORD=
SDE_SCREENING_GOOGLE_CLIENT_ID=
SDE_SCREENING_GOOGLE_CLIENT_SECRET=
TI_HIRING_FIREWORKS_API_KEY=
# Google Doc id the ti-hiring-live-doc-subtasks cron job updates (resolved from this file by that job's prompt)
TI_HIRING_TRACKER_DOC_ID=

# Local tool/UI knobs (sora)
CAMOFOX_URL=
HERMES_TUI_SCROLL_SPEED=
