# .env template — copy to ~/.hermes/.env and fill in real values.
# NEVER commit the real .env — it contains secrets.

# TrueFoundry — two distinct keys:
# TFY_API_KEY: used by the claude/codex CLIs themselves (exported into tmux by the plugin)
# TRUEFOUNDRY_API_KEY: used by hermes's own provider config (providers.truefoundry.api_key)
TFY_API_KEY=
TRUEFOUNDRY_API_KEY=
# TRUEFOUNDRY_PERSONAL_TOKEN: providers.truefoundry-gpt6 / seatbelt-codex api_key and the seatbelt x-tfy-api-key header
TRUEFOUNDRY_PERSONAL_TOKEN=
# MAAT_API_TOKEN: x-maat-token header for the Seatbelt gateway
MAAT_API_TOKEN=

# Fireworks (fallback + auxiliary routes: kimi-k3p1-pro, glm-5p3-flash)
FIREWORKS_API_KEY=

# MCP server Authorization headers (full header value, e.g. "Bearer ...")
SUPABASE_MCP_AUTHORIZATION=
TICOONS_MCP_AUTHORIZATION=
RECALL_MCP_AUTHORIZATION=

# WhatsApp bridge (disabled — bridge drops from-me group messages on personal number)
WHATSAPP_ENABLED=false
WHATSAPP_MODE=bot
WHATSAPP_ALLOWED_USERS=

# Telegram bot token (configured via `hermes gateway setup`)
TELEGRAM_BOT_TOKEN=
