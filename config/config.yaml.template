#    - command: ~/.hermes/agent-hooks/aws-token-refresh.sh
#      matcher: ^terminal$
#      timeout: 10
#  subagent_stop:
#    - command: ~/.hermes/agent-hooks/subagent-ledger.py
#      timeout: 5

# Delegation: subagents auto-approve their tool actions (no silent auto-deny
# stalls). Subagents can't ask for approval — without this they look "stuck"
# when a tool needs it. Tier safeguards (deny-guard on T3, no-commit-to-main
# hooks) still bind them.
delegation:
  model: accounts/fireworks/models/kimi-k3
  provider: fireworks
  max_concurrent_children: 5
  max_spawn_depth: 4
  child_timeout_seconds: 1800
  subagent_auto_approve: true

