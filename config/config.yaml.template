# Compression knobs — proactive pruning + idle auto-compact so long tier
# sessions don't hit the context wall.
#compression:
#  enabled: true
#  proactive_prune_tokens: 48000        # prune tool output early, before threshold
#  idle_compact_after_seconds: 1800     # auto-compact after 30min idle

# Hooks — subagent_stop fires after every delegate_task child finishes; the
# ledger hook appends the outcome to ~/.hermes/tier_orchestrator/subagent_ledger.jsonl.
# Script lives at scripts/subagent-ledger-hook.py in this repo.
#hooks:
#  subagent_stop:
#    - command: ~/.hermes/scripts/subagent-ledger-hook.py
#      timeout: 5

# Delegation: subagents auto-approve their tool actions (no silent auto-deny
# stalls). Subagents can't ask for approval — without this they look "stuck"
# when a tool needs it. Tier safeguards (deny-guard on T3, no-commit-to-main
# hooks) still bind them.
delegation:
  subagent_auto_approve: true
