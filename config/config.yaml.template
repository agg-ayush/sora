# Hermes config template — copy to ~/.hermes/config.yaml and adjust.
# Secrets (API keys, tokens) go in ~/.hermes/.env, NOT here.

model:
  # Kimi K3 via Fireworks — multimodal, strong at coding/orchestration.
  default: accounts/fireworks/models/kimi-k3
  provider: fireworks
  reasoning_effort: high
  max_tokens: 128000
  aliases:
    k3: fireworks/accounts/fireworks/models/kimi-k3
    glm53: fireworks/accounts/fireworks/models/glm-5p3
    glm53f: fireworks/accounts/fireworks/models/glm-5p3-flash

# Provider config — hermes's own model calls authenticate via TRUEFOUNDRY_API_KEY.
# (The claude/codex CLI subprocesses use TFY_API_KEY for TF-routed models, or
# FIREWORKS_API_KEY for kimi-k3 via Fireworks — both exported by the plugin.)
providers:
  truefoundry:
    api: https://<llm-gateway>.truefoundry.cloud/api/llm/api/inference/openai/v1
    api_key: ${TRUEFOUNDRY_API_KEY}

fallback_providers:
  - model: fireworks-group/glm-5p2
    provider: truefoundry
    reasoning_effort: high
  - model: claude-opus-4-8
    provider: truefoundry

agent:
  max_turns: 200
  verify_on_stop: auto

display:
  # TUI is the default; tier sessions MUST use --cli to override this
  # (the TUI's stdin closes in detached tmux panes).
  interface: tui

# Gateway: Telegram configured (add/remove platforms as needed).
# Run `hermes gateway setup` to configure platforms interactively.

# Kanban: disable auto-decompose — the tier system triages + dispatches manually
# (T1 → T2), not via the kanban dispatcher's auto-decompose fan-out. The default
# (true) causes runaway fan-out (decomposes ready/triage tasks, spawns workers
# that crash, re-dispatches). Leave it off.
kanban:
  auto_decompose: false

