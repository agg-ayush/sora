# Hooks — Hermes hooks live in ~/.hermes/agent-hooks/ (NOT ~/.hermes/scripts/).
# subagent_stop fires after every delegate_task child finishes; the ledger hook
# appends the outcome to ~/.hermes/tier_orchestrator/subagent_ledger.jsonl.
# Scripts live in this repo under scripts/; symlink them into ~/.hermes/agent-hooks/
# (devbox/setup-hermes.sh wires the symlinks). Available hooks:
#   scripts/subagent-ledger-hook.py   → subagent_stop → delegation ledger
#   scripts/aws-token-refresh-hook.sh → post_tool_call → auto saml2aws refresh on expired AWS token
#hooks:
